# ── Database ──────────────────────────────────────────────────────────────────
MYSQL_ROOT_PASSWORD=your_strong_password_here

# ── Security ──────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 64
JWT_KEY=your_64_char_minimum_secret_key_here

# ── Email ─────────────────────────────────────────────────────────────────────
GMAIL_USERNAME=your_gmail@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
GMAIL_FROM_EMAIL=your_gmail@gmail.com

# ── Paymob (Egyptian payment gateway) ─────────────────────────────────────────
# Get these from https://accept.paymob.com/portal2/en/settings
PAYMOB_API_KEY=your_paymob_api_key
PAYMOB_INTEGRATION_ID=your_integration_id
PAYMOB_IFRAME_ID=your_iframe_id
PAYMOB_HMAC_SECRET=your_hmac_secret

# ── Kill Switch ───────────────────────────────────────────────────────────────
KILLSWITCH_CODE=your_secret_killswitch_code

# ── OCR ───────────────────────────────────────────────────────────────────────
# Get from https://console.mistral.ai/api-keys
MISTRAL_API_KEY=your_mistral_api_key

# ── ngrok (gives a public URL so Paymob callbacks work) ──────────────────────
# Get from https://dashboard.ngrok.com
NGROK_AUTHTOKEN=your_ngrok_auth_token
# Claim a free static domain at https://dashboard.ngrok.com/domains
NGROK_DOMAIN=your-static-domain.ngrok-free.app

# ── Public URL (must match your ngrok domain above, with https://) ────────────
PUBLIC_URL=https://your-static-domain.ngrok-free.app

# ── Docker registry ──────────────────────────────────────────────────────────
REPO_USER=abdulla662
REPO_TOKEN=your_github_personal_access_token
